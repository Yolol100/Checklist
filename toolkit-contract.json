    {"id":"axe-core","version":"4.12.1","trigger_when":"primary Chromium browser evidence runs","outputs":["compact automated accessibility evidence"]},
    {"id":"bounded-link-scan","version":"repo","trigger_when":"full or release_verification","outputs":["EV-LINK-BOUNDED"]},
    {"id":"nu-html-checker","version":"asset-515207969","sha256":"c70279e260e5f4f9e95b3890ef6c9548f90ebdaec2a75219ec41694ab6241e34","trigger_when":"full or release_verification","outputs":["EV-HTML-VNU"]},
    {"id":"lighthouse-ci","version":"0.15.1","trigger_when":"full or release_verification","outputs":["EV-LIGHTHOUSE-LAB"]}
